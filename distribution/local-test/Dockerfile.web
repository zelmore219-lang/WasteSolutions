# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/driver/package.json apps/driver/package.json
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --workspace @corewaste/web --include-workspace-root --strict-ssl=true
COPY apps/web apps/web
ENV VITE_LOCAL_TEST_KIT=true VITE_USE_AUTH_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-corewaste VITE_FIREBASE_API_KEY=local-test-only VITE_FIREBASE_AUTH_DOMAIN=demo-corewaste.firebaseapp.com
RUN npm run build -w @corewaste/web -- --mode local-test
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/dist ./web
COPY --chown=node:node distribution/local-test/web-server.cjs ./web-server.cjs
USER node
EXPOSE 8088
CMD ["node","web-server.cjs"]
