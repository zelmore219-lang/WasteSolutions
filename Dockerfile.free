# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/driver/package.json apps/driver/package.json
COPY apps/api apps/api
COPY apps/web apps/web
COPY config/firebase-client.json config/firebase-client.json
COPY scripts/build-firebase-web.cjs scripts/build-firebase-web.cjs
COPY database database
# Keep install/build/prune in one layer: avoids retaining development dependencies
# in intermediate snapshots on constrained build hosts.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --workspace @corewaste/api --workspace @corewaste/web --include-workspace-root --strict-ssl=true \
    && npm run build -w @corewaste/api \
    && node scripts/build-firebase-web.cjs \
    && npm prune --omit=dev --workspace @corewaste/api --include-workspace-root --ignore-scripts --strict-ssl=true \
    && mkdir -p /runtime/apps/web \
    && mv node_modules /runtime/node_modules \
    && mv apps/api /runtime/apps/api \
    && mv apps/web/dist /runtime/apps/web/dist \
    && mv database /runtime/database \
    && chmod -R a+rX /runtime
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080 COREWASTE_WEB_DIST=/app/apps/web/dist
COPY --from=build /runtime/ ./
USER node
EXPOSE 8080
CMD ["node","apps/api/dist/main.js"]
