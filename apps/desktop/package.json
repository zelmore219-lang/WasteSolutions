{
  "name": "@corewaste/desktop",
  "private": true,
  "version": "0.3.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:windows": "electron-builder --win nsis --publish never",
    "package:windows:zip": "electron-builder --win zip --publish never",
    "package:windows:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.corewaste.office",
    "productName": "CoreWaste",
    "files": [
      "main.cjs",
      "connection.cjs",
      "preload.cjs",
      "setup.html",
      "setup.js",
      "setup.css",
      "package.json",
      "local-test.cjs",
      "hosted.cjs",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "CoreWaste-Test-${version}-${arch}.${ext}",
    "directories": {
      "output": "../../.local/windows-test"
    },
    "electronVersion": "45.2.3",
    "afterPack": "./brand-windows.cjs",
    "extraFiles": [
      {
        "from": "assets/app-icon.ico",
        "to": "corewaste.ico"
      }
    ]
  },
  "description": "CoreWaste Windows office test client",
  "author": "WasteSolutions"
}
