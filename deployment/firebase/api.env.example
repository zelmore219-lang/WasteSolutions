# Google Cloud Run environment values; no passwords or credentials belong here.
NODE_ENV=production
FIREBASE_PROJECT_ID=wastesoloutions
WEB_ORIGIN=https://wastesoloutions.web.app
STORAGE_DRIVER=gcs
GCS_BUCKET=wastesoloutions.firebasestorage.app
NOTIFICATIONS_WORKER_ENABLED=false
PAYMENTS_MODE=test
# DATABASE_URL must come from Secret Manager and use the Cloud SQL Unix socket.
# Example (not a real password): postgresql://APP_USER:URL_ENCODED_PASSWORD@localhost/corewaste?host=/cloudsql/PROJECT:REGION:INSTANCE
# Keep Stripe/QuickBooks/notification/routing keys unset until accepted separately.

# PROVIDER_SETTINGS_KEY must come from a separate Secret Manager secret (base64 32-byte random key).
