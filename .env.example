# Local development only. Production must use managed secrets and a private database.
DATABASE_URL=postgres://corewaste:corewaste_local_only@127.0.0.1:5432/corewaste
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Firebase project configuration is required for authenticated application access.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Use Application Default Credentials for firebase-admin; never commit service account keys.
# Optional: employee username login uses a verified Firebase email alias at this company-owned domain.
# Provision employee Firebase email as USERNAME@DOMAIN. Customers can continue using full email addresses.
VITE_EMPLOYEE_LOGIN_DOMAIN=
# Online payments (configure securely when connecting Stripe; never commit real values):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_WEB_URL=
# Local development emulator only. Keep unset for all production environments.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_USE_AUTH_EMULATOR=true

# Optional QuickBooks integration; keep secrets in environment settings/secret manager.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_MODE=sandbox
INTEGRATION_ENCRYPTION_KEY=
# Native driver builds use the same Firebase project with an HTTPS API base ending in /api.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Road planning: Amazon Location Geo Routes v2, server-side API key restricted to routing.
# Requests can incur provider charges. Keep credentials out of VITE_/EXPO_PUBLIC_ variables.
ROUTING_REGION=
ROUTING_API_KEY=
# Optional licensed XYZ basemap. Template must use HTTPS and {z}/{x}/{y}.
# Tile requests come from the browser; configure required attribution and public access restrictions.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Provider settings: inject a securely generated base64 32-byte encryption key.
# Keep stable, back it up securely, and never expose it as a VITE variable.
PROVIDER_SETTINGS_KEY=
